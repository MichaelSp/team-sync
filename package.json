{
  "name": "team-sync",
  "version": "0.9.0",
  "private": true,
  "description": "GitHub action to synchronize GitHub Teams with the contents of a teams document",
  "main": "dist/main.mjs",
  "types": "module",
  "scripts": {
    "build": "bun build --entrypoint src/main.ts --target node --outdir dist --sourcemap=external && mv dist/main.js dist/main.mjs && mv dist/main.js.map dist/main.mjs.map",
    "format": "prettier --write **/*.ts",
    "format-check": "prettier --check **/*.ts",
    "lint": "eslint src/**/*.ts",
    "test": "bun test",
    "all": "bun run format && bun run lint && bun test && bun run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rmacklin/team-sync.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup",
    "github",
    "teams"
  ],
  "author": "Richard Macklin",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.0.0",
    "@sindresorhus/slugify": "^3.0.0",
    "js-yaml": "^5.0.0",
    "typescript-eslint": "^8.44.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.4.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "26.2.0",
    "@vercel/ncc": "0.45.0",
    "baseline-browser-mapping": "2.11.18",
    "eslint": "10.9.0",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-jest": "29.16.1",
    "globals": "17.11.0",
    "jest": "30.4.2",
    "prettier": "3.9.6",
    "ts-jest": "29.4.12",
    "typescript": "7.0.2"
  }
}
